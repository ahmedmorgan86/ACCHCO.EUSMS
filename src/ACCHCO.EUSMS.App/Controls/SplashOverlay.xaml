<UserControl x:Class="ACCHCO.EUSMS.App.Controls.SplashOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="SplashRoot">
    <Grid Background="#FF0F172A">
        <Border Background="#FF1E293B" CornerRadius="20" Padding="40" Width="440" Height="360"
                HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#FF334155" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Opacity="0.3" ShadowDepth="10" Color="#FF020617" />
            </Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="/Assets/logo.png" Height="70" Margin="0,0,0,16" />
                <TextBlock Text="ACCHCO EUSMS" FontSize="24" FontWeight="ExtraBold" Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock Text="نظام إدارة دعم المستخدمين للأجهزة" FontSize="13" Foreground="#FF94A3B8"
                           HorizontalAlignment="Center" Margin="0,6,0,28" />
                <ProgressBar IsIndeterminate="True" Width="260" Height="4"
                             Foreground="#FF38BDF8" Background="#FF334155" Margin="0,0,0,14" BorderThickness="0" />
                <TextBlock Text="جاري إعداد النظام والاتصال بالدومين..." FontSize="12" Foreground="#FF64748B"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
