<UserControl x:Class="ACCHCO.EUSMS.App.Controls.NotificationSnackbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20">
    <Border Background="#FF323232" CornerRadius="4" Padding="20,10" MinWidth="300" MaxWidth="600">
        <TextBlock x:Name="MessageText" Foreground="White" FontSize="14" TextWrapping="Wrap" />
    </Border>
</UserControl>
