<Window x:Class="ACCHCO.EUSMS.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:ACCHCO.EUSMS.App.Controls"
        FlowDirection="RightToLeft"
        Icon="/Assets/app.ico"
        Title="نظام إدارة دعم المستخدمين للأجهزة - EUSMS"
        Height="800" Width="1366" MinHeight="650" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#FFF8FAFC">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar (Elite Enterprise Dark Theme) -->
        <Border Grid.Column="0" Background="#FF0F172A" BorderBrush="#FF1E293B" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Image Source="/Assets/logo.png" Height="42" />
                    </StackPanel>
                    <TextBlock Text="ACCHCO EUSMS" FontSize="16" FontWeight="ExtraBold" Foreground="White" FlowDirection="LeftToRight" HorizontalAlignment="Center" />
                    <TextBlock Text="إدارة دعم المستخدمين للأجهزة" FontSize="11" Foreground="#FF94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    
                    <Border Background="#1A38BDF8" CornerRadius="8" Padding="10,8" Margin="0,14,0,0" BorderBrush="#3338BDF8" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="👤 " VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtCurrentUser" Text="" FontSize="12" Foreground="#FF38BDF8" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <Border DockPanel.Dock="Bottom" Padding="16" BorderBrush="#FF1E293B" BorderThickness="0,1,0,0" Background="#FF0B1120">
                    <StackPanel>
                        <TextBlock x:Name="TxtCopyright" FontSize="10" Foreground="#FF64748B" />
                        <TextBlock Text="Alexandria Container &amp; Cargo Handling Co." FontSize="9" Foreground="#FF64748B" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Navigation Menu -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,10">
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButtonStyle}"
                                     IsChecked="True" Content="  📊 لوحة التحكم" />
                        <RadioButton x:Name="NavTickets" Style="{StaticResource NavButtonStyle}"
                                     Content="  🎫 إدارة التذاكر" />
                        <RadioButton x:Name="NavEquipment" Style="{StaticResource NavButtonStyle}"
                                     Content="  💻 المعدات والأجهزة" />
                        <RadioButton x:Name="NavDevices" Style="{StaticResource NavButtonStyle}"
                                     Content="  🌐 أجهزة الشبكة" />
                        <RadioButton x:Name="NavReplacements" Style="{StaticResource NavButtonStyle}"
                                     Content="  🔄 استبدال الأجهزة" />
                        <RadioButton x:Name="NavHandover" Style="{StaticResource NavButtonStyle}"
                                     Content="  📋 تسليم الورديات" />

                        <!-- Section Header: Analytics & Reports -->
                        <TextBlock Text="التقارير والتحليلات" FontSize="11" FontWeight="Bold" Foreground="#FF64748B" Margin="16,16,16,6" />
                        <RadioButton x:Name="NavReports" Style="{StaticResource NavButtonStyle}"
                                     Content="  📈 التقارير الشاملة" />
                        <RadioButton x:Name="NavPerformance" Style="{StaticResource NavButtonStyle}"
                                     Content="  ⚡ تحليلات الأداء" />

                        <!-- Section Header: Administration -->
                        <TextBlock Text="الإدارة والنظام" FontSize="11" FontWeight="Bold" Foreground="#FF64748B" Margin="16,16,16,6" />
                        <RadioButton x:Name="NavUsers" Style="{StaticResource NavButtonStyle}"
                                     Content="  👥 إدارة المستخدمين" />
                        <RadioButton x:Name="NavAuditLog" Style="{StaticResource NavButtonStyle}"
                                     Content="  📜 سجل المراجعة" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButtonStyle}"
                                     Content="  ⚙️ إعدادات النظام" />

                        <!-- Help -->
                        <TextBlock Text="المساعدة والدعم" FontSize="11" FontWeight="Bold" Foreground="#FF64748B" Margin="16,16,16,6" />
                        <RadioButton x:Name="NavHelp" Style="{StaticResource NavButtonStyle}"
                                     Content="  📖 دليل الاستخدام PDF" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Column="1" x:Name="MainContent" Margin="0" />
        
        <!-- Overlays -->
        <Controls:LoadingOverlay Grid.Column="1" x:Name="MainLoadingOverlay" />
        <Controls:NotificationSnackbar Grid.Column="1" x:Name="MainSnackbar" />

        <!-- Splash Screen -->
        <Controls:SplashOverlay Grid.ColumnSpan="2" x:Name="MainSplashOverlay" />
    </Grid>
</Window>
