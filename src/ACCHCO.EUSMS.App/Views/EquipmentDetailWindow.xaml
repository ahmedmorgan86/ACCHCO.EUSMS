<Window x:Class="ACCHCO.EUSMS.App.Views.EquipmentDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ACCHCO.EUSMS.App.ViewModels"
        xmlns:helpers="clr-namespace:ACCHCO.EUSMS.App.Helpers"
        xmlns:data="clr-namespace:ACCHCO.EUSMS.Data.Entities;assembly=ACCHCO.EUSMS.Data"
        FlowDirection="RightToLeft"
        Icon="/Assets/app.ico"
        Title="إضافة / تعديل معدة" Width="820" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FFF8FAFC">

    <Window.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBooleanConverter x:Key="InverseBool" />
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <helpers:NullToBoolConverter x:Key="NullToBool" />
        <helpers:NullToVisibilityConverter x:Key="NullToVis" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource DialogTitleStyle}"
                       Text="➕ إضافة معدة جديدة"
                       Visibility="{Binding IsNewEquipment, Converter={StaticResource BoolToVis}}" />
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource DialogTitleStyle}"
                       Text="✏️ تعديل بيانات المعدة"
                       Visibility="{Binding IsNewEquipment, Converter={StaticResource InverseBoolToVis}}" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="معلومات المعدة الأساسية" Style="{StaticResource SectionHeaderStyle}" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,18,12" Width="230">
                                <TextBlock Text="اسم المعدة *" FontSize="12" FontWeight="SemiBold" Foreground="#FF475569" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditEquipment.Name, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                            </StackPanel>
                            <StackPanel Margin="0,0,18,12" Width="230">
                                <TextBlock Text="النوع" FontSize="12" FontWeight="SemiBold" Foreground="#FF475569" Margin="0,0,0,4" />
                                <ComboBox SelectedValue="{Binding EditEquipment.Type}" SelectedValuePath="Tag" Width="220" Padding="6,6" FontSize="13">
                                    <ComboBoxItem Content="ونش ساحة (RTG)" Tag="{x:Static data:EquipmentType.RTG}" />
                                    <ComboBoxItem Content="معدة كالمر (Calmr)" Tag="{x:Static data:EquipmentType.Kalmar}" />
                                    <ComboBoxItem Content="معدة هيستر (Hastr)" Tag="{x:Static data:EquipmentType.Hyster}" />
                                    <ComboBoxItem Content="رافع حاويات (RS)" Tag="{x:Static data:EquipmentType.ReachStacker}" />
                                    <ComboBoxItem Content="نقطة وصول" Tag="{x:Static data:EquipmentType.AccessPoint}" />
                                    <ComboBoxItem Content="جهاز كمبيوتر" Tag="{x:Static data:EquipmentType.PC}" />
                                    <ComboBoxItem Content="طابعة" Tag="{x:Static data:EquipmentType.Printer}" />
                                    <ComboBoxItem Content="كاميرات البوابات" Tag="{x:Static data:EquipmentType.GatesOcrCamera}" />
                                    <ComboBoxItem Content="جهاز لاسلكي" Tag="{x:Static data:EquipmentType.RDT}" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,18,12" Width="170">
                                <TextBlock Text="رقم الأصل" FontSize="12" FontWeight="SemiBold" Foreground="#FF475569" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditEquipment.AssetTag, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                            </StackPanel>
                            <StackPanel Margin="0,0,18,12" Width="170">
                                <TextBlock Text="عنوان IP" FontSize="12" FontWeight="SemiBold" Foreground="#FF475569" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditEquipment.IpAddress, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="13" />
                            </StackPanel>
                            <StackPanel Margin="0,0,18,12" Width="170">
                                <TextBlock Text="الحالة" FontSize="12" FontWeight="SemiBold" Foreground="#FF475569" Margin="0,0,0,4" />
                                <ComboBox SelectedValue="{Binding EditEquipment.Status}" SelectedValuePath="Tag" Width="160" Padding="6,6" FontSize="13">
                                    <ComboBoxItem Content="نشط" Tag="{x:Static data:EquipmentStatus.Active}" />
                                    <ComboBoxItem Content="غير نشط" Tag="{x:Static data:EquipmentStatus.Inactive}" />
                                    <ComboBoxItem Content="قيد الصيانة" Tag="{x:Static data:EquipmentStatus.UnderMaintenance}" />
                                    <ComboBoxItem Content="مفقود" Tag="{x:Static data:EquipmentStatus.Lost}" />
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16" Margin="10,12,10,0" BorderBrush="#FFE2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="إلغاء" Padding="20,10" Margin="0,0,10,0" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="حفظ البيانات" Command="{Binding SaveEquipmentCommand}"
                        Style="{StaticResource ActionButtonStyle}" Padding="22,10" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
