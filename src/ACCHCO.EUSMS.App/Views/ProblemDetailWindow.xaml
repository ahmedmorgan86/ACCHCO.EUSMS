<Window x:Class="ACCHCO.EUSMS.App.Views.ProblemDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:ACCHCO.EUSMS.Data.Entities;assembly=ACCHCO.EUSMS.Data"
        FlowDirection="RightToLeft"
        Icon="/Assets/app.ico"
        Title="إضافة/تعديل مشكلة" Width="800" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="بيانات المشكلة" Style="{StaticResource DialogTitleStyle}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="العنوان" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditProblem.Title, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="الوصف" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditProblem.Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60" Padding="6,4" />
                    </StackPanel>

                    <WrapPanel>
                        <StackPanel Margin="0,0,15,8" Width="160">
                            <TextBlock Text="الأولوية" FontSize="11" Foreground="#FF888888" />
                            <ComboBox SelectedValue="{Binding EditProblem.Priority}" SelectedValuePath="Tag" Width="150">
                                <ComboBoxItem Content="منخفضة" Tag="{x:Static enums:Priority.Low}" />
                                <ComboBoxItem Content="متوسطة" Tag="{x:Static enums:Priority.Medium}" />
                                <ComboBoxItem Content="عالية" Tag="{x:Static enums:Priority.High}" />
                                <ComboBoxItem Content="حرجة" Tag="{x:Static enums:Priority.Critical}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,15,8" Width="180">
                            <TextBlock Text="الحالة" FontSize="11" Foreground="#FF888888" />
                            <ComboBox SelectedValue="{Binding EditProblem.Status}" SelectedValuePath="Tag" Width="170">
                                <ComboBoxItem Content="مسجّلة" Tag="{x:Static enums:ProblemStatus.Logged}" />
                                <ComboBoxItem Content="قيد البحث" Tag="{x:Static enums:ProblemStatus.Investigating}" />
                                <ComboBoxItem Content="تم تحديد السبب الجذري" Tag="{x:Static enums:ProblemStatus.RootCauseIdentified}" />
                                <ComboBoxItem Content="حل بديل معروف" Tag="{x:Static enums:ProblemStatus.WorkaroundKnown}" />
                                <ComboBoxItem Content="تم الحل" Tag="{x:Static enums:ProblemStatus.Resolved}" />
                                <ComboBoxItem Content="مغلقة" Tag="{x:Static enums:ProblemStatus.Closed}" />
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="السبب الجذري" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditProblem.RootCause, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="50" Padding="6,4" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="الحل البديل" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditProblem.Workaround, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="50" Padding="6,4" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="الحل الدائم" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditProblem.PermanentSolution, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="50" Padding="6,4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="إلغاء" Padding="16,8" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="حفظ" Command="{Binding SaveCommand}"
                        Style="{StaticResource ActionButtonStyle}" Padding="16,8" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
