<Window x:Class="ACCHCO.EUSMS.App.Views.ChangeDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:ACCHCO.EUSMS.Data.Entities;assembly=ACCHCO.EUSMS.Data"
        FlowDirection="RightToLeft"
        Icon="/Assets/app.ico"
        Title="إضافة/تعديل طلب تغيير" Width="800" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="بيانات طلب التغيير" Style="{StaticResource DialogTitleStyle}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="العنوان" FontSize="11" Foreground="#FF888888" />
                    <TextBox Text="{Binding EditChange.Title, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                </StackPanel>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="الوصف" FontSize="11" Foreground="#FF888888" />
                    <TextBox Text="{Binding EditChange.Description, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="60" Padding="6,4" />
                </StackPanel>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="السبب" FontSize="11" Foreground="#FF888888" />
                    <TextBox Text="{Binding EditChange.Reason, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="50" Padding="6,4" />
                </StackPanel>

                <WrapPanel>
                    <StackPanel Margin="0,0,15,8" Width="160">
                        <TextBlock Text="نوع التغيير" FontSize="11" Foreground="#FF888888" />
                        <ComboBox SelectedValue="{Binding EditChange.ChangeType}" SelectedValuePath="Tag" Width="150">
                            <ComboBoxItem Content="قياسي" Tag="{x:Static enums:ChangeType.Standard}" />
                            <ComboBoxItem Content="عادي" Tag="{x:Static enums:ChangeType.Normal}" />
                            <ComboBoxItem Content="طوارئ" Tag="{x:Static enums:ChangeType.Emergency}" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="160">
                        <TextBlock Text="مستوى المخاطرة" FontSize="11" Foreground="#FF888888" />
                        <ComboBox SelectedValue="{Binding EditChange.RiskLevel}" SelectedValuePath="Tag" Width="150">
                            <ComboBoxItem Content="منخفض" Tag="{x:Static enums:ChangeRisk.Low}" />
                            <ComboBoxItem Content="متوسط" Tag="{x:Static enums:ChangeRisk.Medium}" />
                            <ComboBoxItem Content="عالي" Tag="{x:Static enums:ChangeRisk.High}" />
                            <ComboBoxItem Content="حرج" Tag="{x:Static enums:ChangeRisk.Critical}" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="180">
                        <TextBlock Text="التاريخ المجدول" FontSize="11" Foreground="#FF888888" />
                        <DatePicker SelectedDate="{Binding EditChange.ScheduledDate}" Width="170" />
                    </StackPanel>
                </WrapPanel>

                <StackPanel Margin="0,0,0,8" Width="240" HorizontalAlignment="Right">
                    <TextBlock Text="المسؤول عن التنفيذ" FontSize="11" Foreground="#FF888888" />
                    <TextBox Text="{Binding EditChange.AssignedToName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="إلغاء" Padding="16,8" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="حفظ" Command="{Binding SaveCommand}"
                        Style="{StaticResource ActionButtonStyle}" Padding="16,8" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
