<UserControl x:Class="ACCHCO.EUSMS.App.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ACCHCO.EUSMS.App.ViewModels"
             xmlns:helpers="clr-namespace:ACCHCO.EUSMS.App.Helpers"
             FlowDirection="RightToLeft"
             Loaded="OnLoaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="سجل المراجعة" Style="{StaticResource PageTitleStyle}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="📊 تصدير إلى Excel" Command="{Binding ExportToExcelCommand}"
                    Style="{StaticResource ActionButtonStyle}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="16">
            <WrapPanel>
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="من" FontSize="11" Foreground="#FF888888" />
                    <DatePicker SelectedDate="{Binding FilterFrom}" Width="140" />
                </StackPanel>
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="إلى" FontSize="11" Foreground="#FF888888" />
                    <DatePicker SelectedDate="{Binding FilterTo}" Width="140" />
                </StackPanel>
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="اسم المستخدم" FontSize="11" Foreground="#FF888888" />
                    <TextBox Width="150" Text="{Binding FilterUsername, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                </StackPanel>
                <Button Content="تصفية" Command="{Binding FilterCommand}" Style="{StaticResource ActionButtonStyle}"
                        VerticalAlignment="Bottom" Margin="0,0,8,0" Padding="12,8" />
                <Button Content="الكل" Command="{Binding LoadDataCommand}" VerticalAlignment="Bottom" Padding="12,8" />
            </WrapPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Logs}" Style="{StaticResource DataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}" Width="140" />
                <DataGridTextColumn Header="المستخدم" Binding="{Binding Username}" Width="120" />
                <DataGridTextColumn Header="الإجراء" Binding="{Binding Action}" Width="120" />
                <DataGridTextColumn Header="الكيان" Binding="{Binding EntityName}" Width="100" />
                <DataGridTextColumn Header="رقم الكيان" Binding="{Binding EntityId}" Width="70" />
                <DataGridTextColumn Header="التفاصيل" Binding="{Binding NewValues}" Width="*" />
                <DataGridTextColumn Header="الجهاز" Binding="{Binding MachineName}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
