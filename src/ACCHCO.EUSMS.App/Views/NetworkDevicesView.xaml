<UserControl x:Class="ACCHCO.EUSMS.App.Views.NetworkDevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ACCHCO.EUSMS.App.ViewModels"
             xmlns:helpers="clr-namespace:ACCHCO.EUSMS.App.Helpers"
             xmlns:data="clr-namespace:ACCHCO.EUSMS.Data.Entities;assembly=ACCHCO.EUSMS.Data"
             FlowDirection="RightToLeft"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:NullToVisibilityConverter x:Key="NullToVis" />
        <helpers:EnumToArabicConverter x:Key="EnumToArabic" />
        <helpers:BoolToStatusColorConverter x:Key="StatusColorConv" />
        <helpers:BoolToStatusTextConverter x:Key="StatusTextConv" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="أجهزة الشبكة" Style="{StaticResource PageTitleStyle}" />

        <!-- أزرار التحكم -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
            <StackPanel>
                <WrapPanel>
                    <Button Content="🔄 مسح الشبكة" Command="{Binding ScanNetworkCommand}"
                            Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Padding="14,8" />
                    <Button Content="📋 تحميل الأجهزة" Command="{Binding LoadDevicesCommand}"
                            Margin="0,0,10,0" Padding="12,8" />
                    <TextBlock Text="الشبكات: 172.17.10.0/24 - 172.17.30.0/24 - 172.17.20.0/24 - 172.17.70.0/24"
                               VerticalAlignment="Center" FontSize="11" Foreground="#FF555555" FontWeight="SemiBold" />
                </WrapPanel>

                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Text="التصنيف:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#FF888888" />
                    <ComboBox Width="180" SelectedValue="{Binding SelectedCategory}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="الكل" Tag="{x:Static data:DeviceCategory.All}" />
                        <ComboBoxItem Content="أجهزة كمبيوتر" Tag="{x:Static data:DeviceCategory.Computer}" />
                        <ComboBoxItem Content="طابعات" Tag="{x:Static data:DeviceCategory.Printer}" />
                        <ComboBoxItem Content="نقاط وصول" Tag="{x:Static data:DeviceCategory.AccessPoint}" />
                        <ComboBoxItem Content="موزعات شبكية" Tag="{x:Static data:DeviceCategory.Switch}" />
                        <ComboBoxItem Content="كاميرات مراقبة" Tag="{x:Static data:DeviceCategory.Camera}" />
                        <ComboBoxItem Content="خوادم" Tag="{x:Static data:DeviceCategory.Server}" />
                        <ComboBoxItem Content="أجهزة لاسلكية (RDT)" Tag="{x:Static data:DeviceCategory.RDT}" />
                        <ComboBoxItem Content="هواتف شبكي" Tag="{x:Static data:DeviceCategory.Phone}" />
                        <ComboBoxItem Content="أخرى" Tag="{x:Static data:DeviceCategory.Other}" />
                    </ComboBox>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- شريط التقدم -->
        <Border Grid.Row="2" Background="#FFF3E5" Padding="10,6" Margin="0,8,0,8"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⏳ " VerticalAlignment="Center" />
                <TextBlock Text="{Binding ScanStatus}" VerticalAlignment="Center" />
                <ProgressBar Value="{Binding ScanProgress}" Width="200" Height="14"
                             Margin="15,0,0,0" Maximum="100" />
            </StackPanel>
        </Border>

        <!-- قائمة الأجهزة -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredDevices}"
                  SelectedItem="{Binding SelectedDevice}" Style="{StaticResource DataGridStyle}"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="اسم الجهاز" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Hostname}" FontWeight="SemiBold"
                                       Foreground="{Binding IsOnline, Converter={StaticResource StatusColorConv}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="الحالة" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding IsOnline, Converter={StaticResource StatusTextConv}, ConverterParameter=متصل|غير متصل}"
                                       Foreground="{Binding IsOnline, Converter={StaticResource StatusColorConv}}"
                                       FontWeight="SemiBold" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="عنوان IP" Binding="{Binding IpAddress}" Width="120" />
                <DataGridTextColumn Header="عنوان MAC" Binding="{Binding MacAddress}" Width="140" />
                <DataGridTextColumn Header="التصنيف" Binding="{Binding DeviceCategory}" Width="120" />
                <DataGridTextColumn Header="الشركة المصنعة" Binding="{Binding Manufacturer}" Width="120" />
                <DataGridTextColumn Header="آخر ظهور" Binding="{Binding LastSeen, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="130" />
                <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- تفاصيل الجهاز المحدد -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0"
                Visibility="{Binding SelectedDevice, Converter={StaticResource NullToVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="ربط الجهاز بمعدة" FontWeight="Bold" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,15,0" />
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="📝 إنشاء تذكرة لهذا الجهاز" Command="{Binding CreateTicketForDeviceCommand}"
                            Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Padding="14,8" />
                    <TextBlock Text="ربط الجهاز:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                    <TextBlock Text="{Binding SelectedDevice.Hostname, Mode=OneWay}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
