<UserControl x:Class="ACCHCO.EUSMS.App.Views.KnownErrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:ACCHCO.EUSMS.Data.Entities;assembly=ACCHCO.EUSMS.Data"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <TextBlock Text="قاعدة الأخطاء المعروفة" Style="{StaticResource PageTitleStyle}" />

            <Border Style="{StaticResource CardStyle}" Padding="12">
                <WrapPanel>
                    <TextBlock Text="الحالة:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="160" x:Name="CmbStatus" SelectedValue="{Binding FilterStatus}" SelectedValuePath="Tag" FontSize="12">
                        <ComboBoxItem Content="الكل" Tag="{x:Null}" />
                        <ComboBoxItem Content="نشط" Tag="{x:Static enums:KnownErrorStatus.Active}" />
                        <ComboBoxItem Content="حل بديل متاح" Tag="{x:Static enums:KnownErrorStatus.WorkaroundAvailable}" />
                        <ComboBoxItem Content="تم الحل" Tag="{x:Static enums:KnownErrorStatus.Resolved}" />
                        <ComboBoxItem Content="مغلق" Tag="{x:Static enums:KnownErrorStatus.Closed}" />
                    </ComboBox>
                    <TextBox Width="200" Margin="8,0" Text="{Binding FilterSearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    <Button Content="بحث" Command="{Binding FilterCommand}" Style="{StaticResource ActionButtonStyle}" Margin="4,0" />
                    <Button Content="تحميل" Command="{Binding LoadDataCommand}" Style="{StaticResource ActionButtonStyle}" />
                </WrapPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="إضافة" Command="{Binding AddNewCommand}" Style="{StaticResource ActionButtonStyle}" Margin="4,0" />
                        <Button Content="تعديل" Command="{Binding EditCommand}" Style="{StaticResource ActionButtonStyle}" Margin="4,0" />
                        <Button Content="حفظ" Command="{Binding SaveCommand}" Style="{StaticResource ActionButtonStyle}" Margin="4,0" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" />
                        <Button Content="حذف" Command="{Binding DeleteCommand}" Style="{StaticResource ActionButtonStyle}" Margin="4,0" Background="Red" Foreground="White" />
                        <Button Content="إلغاء" Command="{Binding CancelEditCommand}" Style="{StaticResource ActionButtonStyle}" Margin="4,0" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding KnownErrorList}" SelectedItem="{Binding SelectedKnownError}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم" Binding="{Binding KnownErrorNumber}" Width="140" />
                            <DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="الأعراض" Binding="{Binding Symptoms}" Width="200" />
                            <DataGridTextColumn Header="الحل البديل" Binding="{Binding Workaround}" Width="200" />
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="البرامج المرتبطة" Binding="{Binding RelatedSoftware}" Width="140" />
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedDate, StringFormat=yyyy/MM/dd}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="بيانات الخطأ المعروف" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="العنوان:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditKnownError.Title, UpdateSourceTrigger=PropertyChanged}" Margin="4" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="الحالة:" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="3" SelectedValue="{Binding EditKnownError.Status}" SelectedValuePath="Tag" Margin="4">
                            <ComboBoxItem Content="نشط" Tag="{x:Static enums:KnownErrorStatus.Active}" />
                            <ComboBoxItem Content="حل بديل متاح" Tag="{x:Static enums:KnownErrorStatus.WorkaroundAvailable}" />
                            <ComboBoxItem Content="تم الحل" Tag="{x:Static enums:KnownErrorStatus.Resolved}" />
                            <ComboBoxItem Content="مغلق" Tag="{x:Static enums:KnownErrorStatus.Closed}" />
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="الأعراض:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding EditKnownError.Symptoms, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Height="60" AcceptsReturn="True" Margin="4" />
                        <TextBlock Grid.Row="4" Text="الحل البديل:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding EditKnownError.Workaround, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Height="60" AcceptsReturn="True" Margin="4" />
                        <TextBlock Grid.Row="6" Text="الحل الدائم:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding EditKnownError.PermanentSolution, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Height="60" AcceptsReturn="True" Margin="4" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
