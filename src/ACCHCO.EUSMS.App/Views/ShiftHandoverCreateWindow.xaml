<Window x:Class="ACCHCO.EUSMS.App.Views.ShiftHandoverCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:ACCHCO.EUSMS.App.Helpers"
        xmlns:data="clr-namespace:ACCHCO.EUSMS.Data.Entities;assembly=ACCHCO.EUSMS.Data"
        FlowDirection="RightToLeft"
        Icon="/Assets/app.ico"
        Title="تسليمة وردية جديدة" Width="700" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Window.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="تسليمة وردية جديدة" Style="{StaticResource DialogTitleStyle}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,15,8" Width="160">
                        <TextBlock Text="التاريخ *" FontSize="11" Foreground="#FF888888" />
                        <DatePicker SelectedDate="{Binding NewHandover.HandoverDate}" FontSize="13" />
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="120">
                        <TextBlock Text="من وردية" FontSize="11" Foreground="#FF888888" />
                        <ComboBox SelectedValue="{Binding NewHandover.FromShift}" SelectedValuePath="Tag" FontSize="13">
                            <ComboBoxItem Content="الحمراء" Tag="{x:Static data:Shift.Red}" />
                            <ComboBoxItem Content="الصفراء" Tag="{x:Static data:Shift.Yellow}" />
                            <ComboBoxItem Content="الزرقاء" Tag="{x:Static data:Shift.Blue}" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="120">
                        <TextBlock Text="إلى وردية" FontSize="11" Foreground="#FF888888" />
                        <ComboBox SelectedValue="{Binding NewHandover.ToShift}" SelectedValuePath="Tag" FontSize="13">
                            <ComboBoxItem Content="الحمراء" Tag="{x:Static data:Shift.Red}" />
                            <ComboBoxItem Content="الصفراء" Tag="{x:Static data:Shift.Yellow}" />
                            <ComboBoxItem Content="الزرقاء" Tag="{x:Static data:Shift.Blue}" />
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="الملخص *" FontSize="11" Foreground="#FF888888" />
                    <TextBox Text="{Binding NewHandover.Summary, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="80" Padding="6,4" FontSize="13" />
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="المهام المعلقة" FontSize="11" Foreground="#FF888888" />
                    <TextBox Text="{Binding NewHandover.PendingTasks, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="60" Padding="6,4" FontSize="13" />
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="ملاحظات هامة" FontSize="11" Foreground="#FF888888" />
                    <TextBox Text="{Binding NewHandover.ImportantNotes, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="60" Padding="6,4" FontSize="13" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="إلغاء" Padding="16,8" Margin="0,0,8,0" Click="OnCancel" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="حفظ التسليمة" Padding="16,8"
                    Style="{StaticResource ActionButtonStyle}" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
