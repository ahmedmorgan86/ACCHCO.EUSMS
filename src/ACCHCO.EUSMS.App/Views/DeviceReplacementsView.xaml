<UserControl x:Class="ACCHCO.EUSMS.App.Views.DeviceReplacementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Loaded="OnLoaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="استبدال الأجهزة" Style="{StaticResource PageTitleStyle}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="➕ تسجيل استبدال جديد" Command="{Binding AddNewCommand}"
                    Style="{StaticResource ActionButtonStyle}" />
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding ReplacementsList}" Style="{StaticResource DataGridStyle}"
                  SelectedItem="{Binding SelectedReplacement}"
                  AutoGenerateColumns="False">
            <DataGrid.ContextMenu>
                <ContextMenu FlowDirection="RightToLeft">
                    <MenuItem Header="📄 عرض وتعديل الاستبدال" Command="{Binding EditCommand}" />
                    <MenuItem Header="🗑️ حذف الاستبدال" Command="{Binding DeleteCommand}" Foreground="#FFDC2626" />
                    <Separator />
                    <MenuItem Header="🔄 تحديث البيانات" Command="{Binding LoadDataCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="الجهاز القديم" Binding="{Binding OldEquipmentName}" Width="180" />
                <DataGridTextColumn Header="الجهاز الجديد" Binding="{Binding NewEquipmentName}" Width="180" />
                <DataGridTextColumn Header="تاريخ الاستبدال" Binding="{Binding ReplacementDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120" />
                <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
