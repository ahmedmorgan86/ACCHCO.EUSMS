<UserControl x:Class="ACCHCO.EUSMS.App.Views.CmdbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:ACCHCO.EUSMS.App.Helpers"
             xmlns:enums="clr-namespace:ACCHCO.EUSMS.Data.Entities;assembly=ACCHCO.EUSMS.Data"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <helpers:NullToBoolConverter x:Key="NullToBool" />
        <helpers:NullToVisibilityConverter x:Key="NullToVis" />
        <helpers:InverseNullToVisibilityConverter x:Key="InverseNullToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="قاعدة إدارة تكوين الخدمات (CMDB)" Style="{StaticResource PageTitleStyle}" DockPanel.Dock="Right" />
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="إلغاء" Command="{Binding CancelEditCommand}" Padding="12,8"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                <Button Content="بحث" Command="{Binding SearchCommand}"
                        Style="{StaticResource ActionButtonStyle}" Padding="12,8"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                <Button Content="حذف" Command="{Binding DeleteCommand}"
                        Background="#FFF44336" Foreground="White" Padding="12,8"
                        IsEnabled="{Binding SelectedCi, Converter={StaticResource NullToBool}}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                <Button Content="تعديل" Command="{Binding EditCommand}" Padding="12,8"
                        IsEnabled="{Binding SelectedCi, Converter={StaticResource NullToBool}}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                <Button Content="إضافة" Command="{Binding AddNewCommand}"
                        Style="{StaticResource ActionButtonStyle}" Padding="12,8"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="12">
            <WrapPanel>
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="نوع المعدات" FontSize="11" Foreground="#FF888888" />
                    <ComboBox Width="150" SelectedValue="{Binding FilterType}" SelectedValuePath="Tag" FontSize="12">
                        <ComboBoxItem Content="الكل" Tag="{x:Null}" />
                        <ComboBoxItem Content="ونش ساحة" Tag="{x:Static enums:EquipmentType.RTG}" />
                        <ComboBoxItem Content="كالمر" Tag="{x:Static enums:EquipmentType.Kalmar}" />
                        <ComboBoxItem Content="هيستر" Tag="{x:Static enums:EquipmentType.Hyster}" />
                        <ComboBoxItem Content="رافع حاويات" Tag="{x:Static enums:EquipmentType.ReachStacker}" />
                        <ComboBoxItem Content="نقطة وصول" Tag="{x:Static enums:EquipmentType.AccessPoint}" />
                        <ComboBoxItem Content="جهاز كمبيوتر" Tag="{x:Static enums:EquipmentType.PC}" />
                        <ComboBoxItem Content="طابعة" Tag="{x:Static enums:EquipmentType.Printer}" />
                        <ComboBoxItem Content="كاميرات بوابات" Tag="{x:Static enums:EquipmentType.GatesOcrCamera}" />
                        <ComboBoxItem Content="جهاز لاسلكي" Tag="{x:Static enums:EquipmentType.RDT}" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="بحث" FontSize="11" Foreground="#FF888888" />
                    <TextBox Width="180" Text="{Binding FilterSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" FontSize="12" />
                </StackPanel>
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="القسم" FontSize="11" Foreground="#FF888888" />
                    <TextBox Width="150" Text="{Binding FilterDepartment, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" FontSize="12" />
                </StackPanel>
                <Button Content="تصفية" Command="{Binding FilterCommand}" Style="{StaticResource ActionButtonStyle}"
                        VerticalAlignment="Bottom" Margin="0,0,5,0" Padding="12,8" />
            </WrapPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding CiList}" Style="{StaticResource DataGridStyle}"
                  SelectedItem="{Binding SelectedCi}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="رقم العنصر" Binding="{Binding CiNumber}" Width="110" />
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="Auto" />
                <DataGridTextColumn Header="النوع" Binding="{Binding EquipmentType}" Width="100" />
                <DataGridTextColumn Header="عنوان IP" Binding="{Binding IpAddress}" Width="110" />
                <DataGridTextColumn Header="اسم الجهاز" Binding="{Binding ComputerName}" Width="120" />
                <DataGridTextColumn Header="القسم" Binding="{Binding Department}" Width="100" />
                <DataGridTextColumn Header="الموقع" Binding="{Binding Location}" Width="120" />
                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"
                Padding="12" Margin="0,10,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                <StackPanel>
                    <TextBlock Text="بيانات عنصر التكوين" Style="{StaticResource SectionHeaderStyle}" />

                    <WrapPanel>
                        <StackPanel Margin="0,0,15,8" Width="200">
                            <TextBlock Text="الاسم" FontSize="11" Foreground="#FF888888" />
                            <TextBox Text="{Binding EditCi.Name, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                        </StackPanel>
                        <StackPanel Margin="0,0,15,8" Width="200">
                            <TextBlock Text="الرقم التسلسلي" FontSize="11" Foreground="#FF888888" />
                            <TextBox Text="{Binding EditCi.SerialNumber, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                        </StackPanel>
                        <StackPanel Margin="0,0,15,8" Width="150">
                            <TextBlock Text="رقم الأصل" FontSize="11" Foreground="#FF888888" />
                            <TextBox Text="{Binding EditCi.AssetTag, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                        </StackPanel>
                        <StackPanel Margin="0,0,15,8" Width="200">
                            <TextBlock Text="اسم الجهاز" FontSize="11" Foreground="#FF888888" />
                            <TextBox Text="{Binding EditCi.ComputerName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                        </StackPanel>
                        <StackPanel Margin="0,0,15,8" Width="150">
                            <TextBlock Text="عنوان IP" FontSize="11" Foreground="#FF888888" />
                            <TextBox Text="{Binding EditCi.IpAddress, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                        </StackPanel>
                        <StackPanel Margin="0,0,15,8" Width="150">
                            <TextBlock Text="القسم" FontSize="11" Foreground="#FF888888" />
                            <TextBox Text="{Binding EditCi.Department, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                        </StackPanel>
                        <StackPanel Margin="0,0,15,8" Width="150">
                            <TextBlock Text="الموقع" FontSize="11" Foreground="#FF888888" />
                            <TextBox Text="{Binding EditCi.Location, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                        </StackPanel>
                        <StackPanel Margin="0,0,15,8" Width="150">
                            <TextBlock Text="الشركة المصنعة" FontSize="11" Foreground="#FF888888" />
                            <TextBox Text="{Binding EditCi.Manufacturer, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                        </StackPanel>
                        <StackPanel Margin="0,0,15,8" Width="150">
                            <TextBlock Text="الطراز" FontSize="11" Foreground="#FF888888" />
                            <TextBox Text="{Binding EditCi.Model, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="الوصف" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditCi.Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="50" Padding="6,4" />
                    </StackPanel>

                    <WrapPanel>
                        <StackPanel Margin="0,0,15,8" Width="160">
                            <TextBlock Text="نوع المعدات" FontSize="11" Foreground="#FF888888" />
                            <ComboBox SelectedValue="{Binding EditCi.EquipmentType}" SelectedValuePath="Tag" Width="150">
                                <ComboBoxItem Content="ونش ساحة" Tag="{x:Static enums:EquipmentType.RTG}" />
                                <ComboBoxItem Content="كالمر" Tag="{x:Static enums:EquipmentType.Kalmar}" />
                                <ComboBoxItem Content="هيستر" Tag="{x:Static enums:EquipmentType.Hyster}" />
                                <ComboBoxItem Content="رافع حاويات" Tag="{x:Static enums:EquipmentType.ReachStacker}" />
                                <ComboBoxItem Content="نقطة وصول" Tag="{x:Static enums:EquipmentType.AccessPoint}" />
                                <ComboBoxItem Content="جهاز كمبيوتر" Tag="{x:Static enums:EquipmentType.PC}" />
                                <ComboBoxItem Content="طابعة" Tag="{x:Static enums:EquipmentType.Printer}" />
                                <ComboBoxItem Content="كاميرات بوابات" Tag="{x:Static enums:EquipmentType.GatesOcrCamera}" />
                                <ComboBoxItem Content="جهاز لاسلكي" Tag="{x:Static enums:EquipmentType.RDT}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,15,8" Width="160">
                            <TextBlock Text="الحالة" FontSize="11" Foreground="#FF888888" />
                            <ComboBox SelectedValue="{Binding EditCi.Status}" SelectedValuePath="Tag" Width="150">
                                <ComboBoxItem Content="تشغيلي" Tag="{x:Static enums:CIStatus.Operational}" />
                                <ComboBoxItem Content="متدهور" Tag="{x:Static enums:CIStatus.Degraded}" />
                                <ComboBoxItem Content="خارج الخدمة" Tag="{x:Static enums:CIStatus.OutOfService}" />
                                <ComboBoxItem Content="متقاعد" Tag="{x:Static enums:CIStatus.Retired}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,15,8" Width="180">
                            <TextBlock Text="تاريخ الشراء" FontSize="11" Foreground="#FF888888" />
                            <DatePicker SelectedDate="{Binding EditCi.PurchaseDate}" Width="170" />
                        </StackPanel>
                        <StackPanel Margin="0,0,15,8" Width="180">
                            <TextBlock Text="انتهاء الضمان" FontSize="11" Foreground="#FF888888" />
                            <DatePicker SelectedDate="{Binding EditCi.WarrantyExpiry}" Width="170" />
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button Content="إلغاء" Command="{Binding CancelEditCommand}" Padding="16,8" Margin="0,0,8,0" />
                        <Button Content="حفظ" Command="{Binding SaveCommand}"
                                Style="{StaticResource ActionButtonStyle}" Padding="16,8" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
