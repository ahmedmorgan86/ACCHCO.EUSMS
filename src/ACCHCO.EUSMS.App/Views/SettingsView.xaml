<UserControl x:Class="ACCHCO.EUSMS.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ACCHCO.EUSMS.App.ViewModels"
             xmlns:helpers="clr-namespace:ACCHCO.EUSMS.App.Helpers"
             FlowDirection="RightToLeft"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:AdStatusConverter x:Key="AdStatusConverter" />
        <helpers:InverseBooleanConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="إعدادات النظام" Style="{StaticResource PageTitleStyle}" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="💾 حفظ جميع الإعدادات" Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource ActionButtonStyle}" Padding="18,10" FontSize="13" />
            </StackPanel>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,16"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <!-- Active Directory Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="🌐 الدليل النشط (Active Directory)" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                        <Border CornerRadius="12" Padding="12,6" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFEE2E2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdAvailable}" Value="True">
                                            <Setter Property="Background" Value="#FFDCFCE7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="12" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFDC2626" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdAvailable}" Value="True">
                                                <Setter Property="Foreground" Value="#FF16A34A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Text>
                                    <Binding Path="IsAdAvailable" Converter="{StaticResource AdStatusConverter}" Mode="OneWay" />
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </DockPanel>

                    <TextBlock Text="التحقق من حالة الاتصال بالدومين ومزامنة أجهزة ومستخدمي الشركة تلقائياً."
                               FontSize="12" Foreground="#FF64748B" Margin="0,0,0,14" />

                    <WrapPanel Margin="0,0,0,16">
                        <Button Content="🔍 فحص الاتصال" Command="{Binding CheckAdCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="14,9" Margin="0,0,10,8" />
                        <Button Content="🔄 مزامنة الأجهزة" Command="{Binding SyncAdComputersCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="14,9" Margin="0,0,10,8"
                                IsEnabled="{Binding IsAdAvailable}" />
                        <Button Content="👤 مزامنة المستخدمين" Command="{Binding SyncAdUsersCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="14,9" Margin="0,0,0,8"
                                IsEnabled="{Binding IsAdAvailable}" />
                    </WrapPanel>

                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,14"
                                 Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVis}}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#FFF8FAFC" CornerRadius="12" Padding="14,12" BorderBrush="#FFE2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🖥️ الأجهزة المسجلة" FontSize="11" Foreground="#FF64748B" />
                                <TextBlock Text="{Binding AdComputerCount, Mode=OneWay}" FontSize="24" FontWeight="ExtraBold"
                                           Foreground="#FF2563EB" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#FFF8FAFC" CornerRadius="12" Padding="14,12" BorderBrush="#FFE2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="👥 المستخدمون المسجلون" FontSize="11" Foreground="#FF64748B" />
                                <TextBlock Text="{Binding AdUserCount, Mode=OneWay}" FontSize="24" FontWeight="ExtraBold"
                                           Foreground="#FF16A34A" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="#FFF8FAFC" CornerRadius="12" Padding="14,12" BorderBrush="#FFE2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⏱️ آخر مزامنة للأجهزة" FontSize="11" Foreground="#FF64748B" />
                                <TextBlock Text="{Binding LastComputerSync, StringFormat='{}{0:dd/MM/yyyy HH:mm}', Mode=OneWay}"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#FF0F172A" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Settings Groups -->
            <ItemsControl ItemsSource="{Binding SettingsGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="{Binding GroupName}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Settings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#FFF1F5F9" BorderThickness="0,0,0,1" Padding="0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="300" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayKey}" FontWeight="SemiBold" FontSize="13" Foreground="#FF1E293B" />
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#FF94A3B8" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="10,8" FontSize="13" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
