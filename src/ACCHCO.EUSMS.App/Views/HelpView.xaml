<UserControl x:Class="ACCHCO.EUSMS.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:ACCHCO.EUSMS.App.Helpers"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBooleanConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel>

            <!-- Hero Banner -->
            <Border CornerRadius="20" Margin="0,0,0,24" Padding="28,30">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FF2563EB" />
                        <GradientStop Offset="1" Color="#FF1E40AF" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" Opacity="0.12" ShadowDepth="4" Color="#FF1E3A8A" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="92" Height="92" CornerRadius="20" Background="White"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" Opacity="0.18" ShadowDepth="3" Color="#FF0F172A" />
                            </Border.Effect>
                            <Image Source="/Assets/logo.png" Width="64" Height="64" Stretch="Uniform"
                                   Margin="10" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="مرحباً بك في نظام EUSMS" FontSize="30" FontWeight="ExtraBold"
                                       Foreground="White" />
                            <TextBlock Text="نظام إدارة دعم المستخدمين للأجهزة — شركة الإسكندرية لتداول الحاويات والبضائع"
                                       FontSize="14" Foreground="#FFDCE8FF" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="22" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Content="📥 تحميل دليل الاستخدام PDF"
                                Command="{Binding DownloadPdfCommand}"
                                IsEnabled="{Binding CanDownload}"
                                Background="White" Foreground="{StaticResource PrimaryBrush}"
                                FontWeight="Bold" Padding="20,11" FontSize="13" Cursor="Hand" />
                        <TextBlock Text="جاري إنشاء PDF..."
                                   Visibility="{Binding LoadingVisibility}"
                                   Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" />
                        <Border Background="#2EFFFFFF" CornerRadius="10" Padding="12,6" Margin="16,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppVersion}" Foreground="White" FontSize="12" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- الأقسام الرئيسية -->
            <TextBlock Text="الأقسام الرئيسية" Style="{StaticResource SectionHeaderStyle}" />
            <ItemsControl ItemsSource="{Binding Features}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="6,6,6,12" Padding="18,16" MinHeight="132">
                            <StackPanel>
                                <Border Width="46" Height="46" CornerRadius="12" Background="{Binding ChipColor}"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Icon}" FontSize="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                           Foreground="#FF0F172A" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#FF64748B"
                                           TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ابدأ في أربع خطوات -->
            <TextBlock Text="ابدأ في أربع خطوات" Style="{StaticResource SectionHeaderStyle}" />
            <ItemsControl ItemsSource="{Binding Steps}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="6,6,6,12" Padding="16,18" MinHeight="120">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource PrimaryBrush}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Number}" FontSize="16" FontWeight="ExtraBold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                                   Foreground="#FF0F172A" />
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#FF64748B"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- نصائح الاستخدام -->
            <TextBlock Text="💡 نصائح وإرشادات" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}" Padding="22" Margin="6,6,6,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="30" Height="30" CornerRadius="9" Background="#FFDBEAFE"
                                VerticalAlignment="Center">
                            <TextBlock Text="⚡" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                        </Border>
                        <TextBlock Text="جميع النوافذ تتكيف تلقائياً مع حجم المحتوى لضمان ظهور كافة الحقول بوضوح."
                                   FontSize="13" Foreground="#FF334155" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="30" Height="30" CornerRadius="9" Background="#FFDCFCE7"
                                VerticalAlignment="Center">
                            <TextBlock Text="🧭" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                        </Border>
                        <TextBlock Text="استخدم القائمة الجانبية للتنقل السريع بين أقسام النظام المختلفة."
                                   FontSize="13" Foreground="#FF334155" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="9" Background="#FFFEF3C7"
                                VerticalAlignment="Center">
                            <TextBlock Text="📄" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                        </Border>
                        <TextBlock Text="يمكنك تحميل هذا الدليل كملف PDF في أي وقت بالضغط على زر التحميل أعلى الصفحة."
                                   FontSize="13" Foreground="#FF334155" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <Border CornerRadius="12" Background="#FFF1F5F9" Padding="16" Margin="6,0,6,4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="© ACCHCO — EUSMS" FontSize="12" Foreground="#FF64748B" />
                    <TextBlock Text="•" FontSize="12" Foreground="#FF94A3B8" Margin="10,0" />
                    <TextBlock Text="{Binding AppVersion}" FontSize="12" Foreground="#FF94A3B8" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
