<UserControl x:Class="ACCHCO.EUSMS.App.Views.ServiceRequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:ACCHCO.EUSMS.Data.Entities;assembly=ACCHCO.EUSMS.Data"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <TextBlock Text="طلبات الخدمة" Style="{StaticResource PageTitleStyle}" />

            <Border Style="{StaticResource CardStyle}" Padding="12">
                <WrapPanel>
                    <TextBlock Text="النوع:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="160" SelectedValue="{Binding FilterType}" SelectedValuePath="Tag" FontSize="12">
                        <ComboBoxItem Content="الكل" Tag="{x:Null}" />
                        <ComboBoxItem Content="تثبيت برنامج" Tag="{x:Static enums:ServiceRequestType.SoftwareInstallation}" />
                        <ComboBoxItem Content="تثبيت طابعة" Tag="{x:Static enums:ServiceRequestType.PrinterInstallation}" />
                        <ComboBoxItem Content="إدخال في النطاق" Tag="{x:Static enums:ServiceRequestType.DomainJoin}" />
                        <ComboBoxItem Content="إعادة تعيين كلمة المرور" Tag="{x:Static enums:ServiceRequestType.PasswordReset}" />
                        <ComboBoxItem Content="طلب صلاحيات" Tag="{x:Static enums:ServiceRequestType.PermissionRequest}" />
                        <ComboBoxItem Content="طلب مجلد مشترك" Tag="{x:Static enums:ServiceRequestType.SharedFolderRequest}" />
                        <ComboBoxItem Content="مستخدم جديد" Tag="{x:Static enums:ServiceRequestType.NewUserRequest}" />
                        <ComboBoxItem Content="طلب بريد" Tag="{x:Static enums:ServiceRequestType.EmailRequest}" />
                        <ComboBoxItem Content="طلب معدات" Tag="{x:Static enums:ServiceRequestType.HardwareRequest}" />
                        <ComboBoxItem Content="وصول لتطبيق" Tag="{x:Static enums:ServiceRequestType.ApplicationAccess}" />
                        <ComboBoxItem Content="أخرى" Tag="{x:Static enums:ServiceRequestType.Other}" />
                    </ComboBox>
                    <TextBlock Text="الحالة:" VerticalAlignment="Center" Margin="8,0,8,0" />
                    <ComboBox Width="140" SelectedValue="{Binding FilterStatus}" SelectedValuePath="Tag" FontSize="12">
                        <ComboBoxItem Content="الكل" Tag="{x:Null}" />
                        <ComboBoxItem Content="جديد" Tag="{x:Static enums:ServiceRequestStatus.New}" />
                        <ComboBoxItem Content="مقدم" Tag="{x:Static enums:ServiceRequestStatus.Submitted}" />
                        <ComboBoxItem Content="معتمد" Tag="{x:Static enums:ServiceRequestStatus.Approved}" />
                        <ComboBoxItem Content="قيد التنفيذ" Tag="{x:Static enums:ServiceRequestStatus.InProgress}" />
                        <ComboBoxItem Content="مكتمل" Tag="{x:Static enums:ServiceRequestStatus.Completed}" />
                        <ComboBoxItem Content="ملغي" Tag="{x:Static enums:ServiceRequestStatus.Cancelled}" />
                        <ComboBoxItem Content="مرفوض" Tag="{x:Static enums:ServiceRequestStatus.Rejected}" />
                    </ComboBox>
                    <Button Content="بحث" Command="{Binding FilterCommand}" Style="{StaticResource ActionButtonStyle}" Margin="4,0" />
                    <Button Content="تحميل" Command="{Binding LoadDataCommand}" Style="{StaticResource ActionButtonStyle}" />
                </WrapPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="إضافة" Command="{Binding AddNewCommand}" Style="{StaticResource ActionButtonStyle}" Margin="4,0" />
                        <Button Content="تعديل" Command="{Binding EditCommand}" Style="{StaticResource ActionButtonStyle}" Margin="4,0" />
                        <Button Content="حفظ" Command="{Binding SaveCommand}" Style="{StaticResource ActionButtonStyle}" Margin="4,0" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" />
                        <Button Content="حذف" Command="{Binding DeleteCommand}" Style="{StaticResource ActionButtonStyle}" Margin="4,0" Background="Red" Foreground="White" />
                        <Button Content="تقديم" Command="{Binding SubmitCommand}" Style="{StaticResource ActionButtonStyle}" Margin="4,0" />
                        <Button Content="موافقة" Command="{Binding ApproveCommand}" Style="{StaticResource ActionButtonStyle}" Margin="4,0" Background="Green" Foreground="White" />
                        <Button Content="رفض" Command="{Binding RejectCommand}" Style="{StaticResource ActionButtonStyle}" Margin="4,0" Background="Orange" Foreground="White" />
                        <Button Content="بدء التنفيذ" Command="{Binding StartCommand}" Style="{StaticResource ActionButtonStyle}" Margin="4,0" />
                        <Button Content="إتمام" Command="{Binding CompleteCommand}" Style="{StaticResource ActionButtonStyle}" Margin="4,0" Background="DarkGreen" Foreground="White" />
                        <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource ActionButtonStyle}" Margin="4,0" Background="Gray" Foreground="White" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding RequestList}" SelectedItem="{Binding SelectedRequest}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم" Binding="{Binding RequestNumber}" Width="140" />
                            <DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="النوع" Binding="{Binding RequestType}" Width="120" />
                            <DataGridTextColumn Header="المتقدم" Binding="{Binding RequesterName}" Width="120" />
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="الموافقة" Binding="{Binding ApprovalStatus}" Width="80" />
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedDate, StringFormat=yyyy/MM/dd}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="بيانات طلب الخدمة" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="النوع:" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" SelectedValue="{Binding EditRequest.RequestType}" SelectedValuePath="Tag" Margin="4">
                            <ComboBoxItem Content="تثبيت برنامج" Tag="{x:Static enums:ServiceRequestType.SoftwareInstallation}" />
                            <ComboBoxItem Content="تثبيت طابعة" Tag="{x:Static enums:ServiceRequestType.PrinterInstallation}" />
                            <ComboBoxItem Content="إدخال في النطاق" Tag="{x:Static enums:ServiceRequestType.DomainJoin}" />
                            <ComboBoxItem Content="إعادة تعيين كلمة المرور" Tag="{x:Static enums:ServiceRequestType.PasswordReset}" />
                            <ComboBoxItem Content="طلب صلاحيات" Tag="{x:Static enums:ServiceRequestType.PermissionRequest}" />
                            <ComboBoxItem Content="طلب مجلد مشترك" Tag="{x:Static enums:ServiceRequestType.SharedFolderRequest}" />
                            <ComboBoxItem Content="مستخدم جديد" Tag="{x:Static enums:ServiceRequestType.NewUserRequest}" />
                            <ComboBoxItem Content="طلب بريد" Tag="{x:Static enums:ServiceRequestType.EmailRequest}" />
                            <ComboBoxItem Content="طلب معدات" Tag="{x:Static enums:ServiceRequestType.HardwareRequest}" />
                            <ComboBoxItem Content="وصول لتطبيق" Tag="{x:Static enums:ServiceRequestType.ApplicationAccess}" />
                            <ComboBoxItem Content="أخرى" Tag="{x:Static enums:ServiceRequestType.Other}" />
                        </ComboBox>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="العنوان:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EditRequest.Title, UpdateSourceTrigger=PropertyChanged}" Margin="4" />
                        <TextBlock Grid.Row="2" Text="الوصف:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding EditRequest.Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Height="60" AcceptsReturn="True" Margin="4" />
                        <TextBlock Grid.Row="4" Text="المتقدم:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EditRequest.RequesterName, UpdateSourceTrigger=PropertyChanged}" Margin="4" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="الإدارة:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding EditRequest.RequesterSection, UpdateSourceTrigger=PropertyChanged}" Margin="4" />
                        <TextBlock Grid.Row="6" Text="المسؤول:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding EditRequest.AssignedToName, UpdateSourceTrigger=PropertyChanged}" Margin="4" />
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="الحالة:" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="6" Grid.Column="3" SelectedValue="{Binding EditRequest.Status}" SelectedValuePath="Tag" Margin="4">
                            <ComboBoxItem Content="جديد" Tag="{x:Static enums:ServiceRequestStatus.New}" />
                            <ComboBoxItem Content="مقدم" Tag="{x:Static enums:ServiceRequestStatus.Submitted}" />
                            <ComboBoxItem Content="معتمد" Tag="{x:Static enums:ServiceRequestStatus.Approved}" />
                            <ComboBoxItem Content="قيد التنفيذ" Tag="{x:Static enums:ServiceRequestStatus.InProgress}" />
                            <ComboBoxItem Content="مكتمل" Tag="{x:Static enums:ServiceRequestStatus.Completed}" />
                            <ComboBoxItem Content="ملغي" Tag="{x:Static enums:ServiceRequestStatus.Cancelled}" />
                            <ComboBoxItem Content="مرفوض" Tag="{x:Static enums:ServiceRequestStatus.Rejected}" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
