<UserControl x:Class="ACCHCO.EUSMS.App.Views.ChangeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:ACCHCO.EUSMS.App.Helpers"
             xmlns:enums="clr-namespace:ACCHCO.EUSMS.Data.Entities;assembly=ACCHCO.EUSMS.Data"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <helpers:NullToBoolConverter x:Key="NullToBool" />
        <helpers:NullToVisibilityConverter x:Key="NullToVis" />
        <helpers:InverseNullToVisibilityConverter x:Key="InverseNullToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="إدارة طلبات التغيير" Style="{StaticResource PageTitleStyle}" DockPanel.Dock="Right" />
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="إلغاء" Command="{Binding CancelEditCommand}" Padding="12,8"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                <Button Content="إلغاء الطلب" Command="{Binding RollbackCommand}" Padding="12,8"
                        IsEnabled="{Binding SelectedChange, Converter={StaticResource NullToBool}}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                <Button Content="إتمام" Command="{Binding CompleteCommand}" Padding="12,8"
                        IsEnabled="{Binding SelectedChange, Converter={StaticResource NullToBool}}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                <Button Content="بدء التنفيذ" Command="{Binding StartImplementationCommand}" Padding="12,8"
                        IsEnabled="{Binding SelectedChange, Converter={StaticResource NullToBool}}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                <Button Content="رفض" Command="{Binding RejectCommand}" Padding="12,8"
                        Background="#FFF44336" Foreground="White"
                        IsEnabled="{Binding SelectedChange, Converter={StaticResource NullToBool}}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                <Button Content="موافقة" Command="{Binding ApproveCommand}" Padding="12,8"
                        Background="#FF4CAF50" Foreground="White"
                        IsEnabled="{Binding SelectedChange, Converter={StaticResource NullToBool}}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                <Button Content="تقديم" Command="{Binding SubmitCommand}" Padding="12,8"
                        IsEnabled="{Binding SelectedChange, Converter={StaticResource NullToBool}}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                <Button Content="حفظ" Command="{Binding SaveCommand}"
                        Style="{StaticResource ActionButtonStyle}" Padding="12,8"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                <Button Content="حذف" Command="{Binding DeleteCommand}"
                        Background="#FFF44336" Foreground="White" Padding="12,8"
                        IsEnabled="{Binding SelectedChange, Converter={StaticResource NullToBool}}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                <Button Content="تعديل" Command="{Binding EditCommand}" Padding="12,8"
                        IsEnabled="{Binding SelectedChange, Converter={StaticResource NullToBool}}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                <Button Content="إضافة" Command="{Binding AddNewCommand}"
                        Style="{StaticResource ActionButtonStyle}" Padding="12,8"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="12">
            <WrapPanel>
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="نوع التغيير" FontSize="11" Foreground="#FF888888" />
                    <ComboBox Width="130" SelectedValue="{Binding FilterChangeType}" SelectedValuePath="Tag" FontSize="12">
                        <ComboBoxItem Content="الكل" Tag="{x:Null}" />
                        <ComboBoxItem Content="قياسي" Tag="{x:Static enums:ChangeType.Standard}" />
                        <ComboBoxItem Content="عادي" Tag="{x:Static enums:ChangeType.Normal}" />
                        <ComboBoxItem Content="طوارئ" Tag="{x:Static enums:ChangeType.Emergency}" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="الحالة" FontSize="11" Foreground="#FF888888" />
                    <ComboBox Width="130" SelectedValue="{Binding FilterStatus}" SelectedValuePath="Tag" FontSize="12">
                        <ComboBoxItem Content="الكل" Tag="{x:Null}" />
                        <ComboBoxItem Content="مسودة" Tag="{x:Static enums:ChangeStatus.Draft}" />
                        <ComboBoxItem Content="مقدم" Tag="{x:Static enums:ChangeStatus.Submitted}" />
                        <ComboBoxItem Content="موافق عليه" Tag="{x:Static enums:ChangeStatus.Approved}" />
                        <ComboBoxItem Content="مجدول" Tag="{x:Static enums:ChangeStatus.Scheduled}" />
                        <ComboBoxItem Content="قيد التنفيذ" Tag="{x:Static enums:ChangeStatus.Implementing}" />
                        <ComboBoxItem Content="قيد الاختبار" Tag="{x:Static enums:ChangeStatus.Testing}" />
                        <ComboBoxItem Content="مكتمل" Tag="{x:Static enums:ChangeStatus.Completed}" />
                        <ComboBoxItem Content="تم التراجع" Tag="{x:Static enums:ChangeStatus.RolledBack}" />
                        <ComboBoxItem Content="ملغي" Tag="{x:Static enums:ChangeStatus.Cancelled}" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="مستوى المخاطرة" FontSize="11" Foreground="#FF888888" />
                    <ComboBox Width="130" SelectedValue="{Binding FilterRisk}" SelectedValuePath="Tag" FontSize="12">
                        <ComboBoxItem Content="الكل" Tag="{x:Null}" />
                        <ComboBoxItem Content="منخفض" Tag="{x:Static enums:ChangeRisk.Low}" />
                        <ComboBoxItem Content="متوسط" Tag="{x:Static enums:ChangeRisk.Medium}" />
                        <ComboBoxItem Content="عالي" Tag="{x:Static enums:ChangeRisk.High}" />
                        <ComboBoxItem Content="حرج" Tag="{x:Static enums:ChangeRisk.Critical}" />
                    </ComboBox>
                </StackPanel>
                <Button Content="تصفية" Command="{Binding FilterCommand}" Style="{StaticResource ActionButtonStyle}"
                        VerticalAlignment="Bottom" Margin="0,0,5,0" Padding="12,8" />
            </WrapPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding ChangeList}" Style="{StaticResource DataGridStyle}"
                  SelectedItem="{Binding SelectedChange}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="رقم التغيير" Binding="{Binding ChangeNumber}" Width="120" />
                <DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="النوع" Binding="{Binding ChangeType}" Width="90" />
                <DataGridTextColumn Header="المخاطرة" Binding="{Binding RiskLevel}" Width="90" />
                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100" />
                <DataGridTextColumn Header="حالة الموافقة" Binding="{Binding ApprovalStatus}" Width="110" />
                <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"
                Padding="12" Margin="0,10,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                <StackPanel>
                    <TextBlock Text="بيانات طلب التغيير" Style="{StaticResource SectionHeaderStyle}" />

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="العنوان" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditChange.Title, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="الوصف" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditChange.Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60" Padding="6,4" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="السبب" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditChange.Reason, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="50" Padding="6,4" />
                    </StackPanel>

                    <WrapPanel>
                        <StackPanel Margin="0,0,15,8" Width="160">
                            <TextBlock Text="نوع التغيير" FontSize="11" Foreground="#FF888888" />
                            <ComboBox SelectedValue="{Binding EditChange.ChangeType}" SelectedValuePath="Tag" Width="150">
                                <ComboBoxItem Content="قياسي" Tag="{x:Static enums:ChangeType.Standard}" />
                                <ComboBoxItem Content="عادي" Tag="{x:Static enums:ChangeType.Normal}" />
                                <ComboBoxItem Content="طوارئ" Tag="{x:Static enums:ChangeType.Emergency}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,15,8" Width="160">
                            <TextBlock Text="مستوى المخاطرة" FontSize="11" Foreground="#FF888888" />
                            <ComboBox SelectedValue="{Binding EditChange.RiskLevel}" SelectedValuePath="Tag" Width="150">
                                <ComboBoxItem Content="منخفض" Tag="{x:Static enums:ChangeRisk.Low}" />
                                <ComboBoxItem Content="متوسط" Tag="{x:Static enums:ChangeRisk.Medium}" />
                                <ComboBoxItem Content="عالي" Tag="{x:Static enums:ChangeRisk.High}" />
                                <ComboBoxItem Content="حرج" Tag="{x:Static enums:ChangeRisk.Critical}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,15,8" Width="180">
                            <TextBlock Text="التاريخ المجدول" FontSize="11" Foreground="#FF888888" />
                            <DatePicker SelectedDate="{Binding EditChange.ScheduledDate}" Width="170" />
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="عناصر التكوين المتأثرة" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditChange.AffectedCIs, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="40" Padding="6,4" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="خطة التراجع" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditChange.RollbackPlan, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="40" Padding="6,4" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8" Width="200" HorizontalAlignment="Right">
                        <TextBlock Text="المسؤول عن التنفيذ" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditChange.AssignedToName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button Content="إلغاء" Command="{Binding CancelEditCommand}" Padding="16,8" Margin="0,0,8,0" />
                        <Button Content="حفظ" Command="{Binding SaveCommand}"
                                Style="{StaticResource ActionButtonStyle}" Padding="16,8" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
