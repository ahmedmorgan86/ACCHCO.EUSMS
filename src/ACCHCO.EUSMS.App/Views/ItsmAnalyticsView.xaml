<UserControl x:Class="ACCHCO.EUSMS.App.Views.ItsmAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <TextBlock Text="تحليلات ITSM" Style="{StaticResource PageTitleStyle}" />

            <WrapPanel Margin="0,0,0,12">
                <Border Style="{StaticResource KpiCardStyle}" Width="220" Margin="6">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="متوسط وقت الحل (MTTR)" FontSize="12" Foreground="#FF666666" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Mttr, StringFormat={}{0:0.00}}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Width="220" Margin="6">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="متوسط وقت اكتشاف المشكلة (MTTB)" FontSize="12" Foreground="#FF666666" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Mttb, StringFormat={}{0:0.00}}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Width="220" Margin="6">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="نسبة الحل عند الاتصال الأول (FCR)" FontSize="12" Foreground="#FF666666" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Fcr, StringFormat={}{0:0.00}%}" FontSize="28" FontWeight="Bold" Foreground="Green" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="12" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="الحوادث حسب الأولوية" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl ItemsSource="{Binding IncidentByPriority}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,4" Margin="0,2" Background="#FFF8F9FA" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Priority}" Width="100" FontSize="12" />
                                            <TextBlock Text="{Binding Count}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="الحوادث حسب الخطورة" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl ItemsSource="{Binding IncidentBySeverity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,4" Margin="0,2" Background="#FFF8F9FA" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Severity}" Width="100" FontSize="12" />
                                            <TextBlock Text="{Binding Count}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="الحوادث حسب الحالة" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl ItemsSource="{Binding IncidentByStatus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,4" Margin="0,2" Background="#FFF8F9FA" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Status}" Width="100" FontSize="12" />
                                            <TextBlock Text="{Binding Count}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="المشاكل حسب الحالة" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl ItemsSource="{Binding ProblemByStatus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,4" Margin="0,2" Background="#FFF8F9FA" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Status}" Width="100" FontSize="12" />
                                            <TextBlock Text="{Binding Count}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="التغييرات حسب الحالة" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl ItemsSource="{Binding ChangeByStatus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,4" Margin="0,2" Background="#FFF8F9FA" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Status}" Width="100" FontSize="12" />
                                            <TextBlock Text="{Binding Count}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="أكثر المتخصصين أداءً" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl ItemsSource="{Binding TopSpecialists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,4" Margin="0,2" Background="#FFF8F9FA" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding SpecialistId}" FontWeight="Bold" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding TotalAssigned, StringFormat='تعيين: {0}'}" FontSize="11" Foreground="#FF666666" Margin="8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding AverageResolutionMinutes, StringFormat='متوسط: {0:0.0} دقيقة'}" FontSize="11" Foreground="{StaticResource PrimaryBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
