<Window x:Class="ACCHCO.EUSMS.App.Views.UserDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ACCHCO.EUSMS.App.ViewModels"
        xmlns:helpers="clr-namespace:ACCHCO.EUSMS.App.Helpers"
        xmlns:data="clr-namespace:ACCHCO.EUSMS.Data.Entities;assembly=ACCHCO.EUSMS.Data"
        FlowDirection="RightToLeft"
        Icon="/Assets/app.ico"
        Title="إضافة/تعديل مستخدم" Width="750" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBooleanConverter x:Key="InverseBool" />
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <helpers:NullToBoolConverter x:Key="NullToBool" />
        <helpers:NullToVisibilityConverter x:Key="NullToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource DialogTitleStyle}"
                       Text="إضافة مستخدم جديد"
                       Visibility="{Binding IsNewUser, Converter={StaticResource BoolToVis}}" />
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource DialogTitleStyle}"
                       Text="تعديل المستخدم"
                       Visibility="{Binding IsNewUser, Converter={StaticResource InverseBoolToVis}}" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="معلومات المستخدم" Style="{StaticResource SectionHeaderStyle}" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,15,8" Width="180">
                                <TextBlock Text="اسم المستخدم *" FontSize="11" Foreground="#FF888888" />
                                <TextBox Text="{Binding EditUser.Username, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            </StackPanel>
                            <StackPanel Margin="0,0,15,8" Width="200">
                                <TextBlock Text="الاسم الكامل *" FontSize="11" Foreground="#FF888888" />
                                <TextBox Text="{Binding EditUser.FullName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            </StackPanel>
                            <StackPanel Margin="0,0,15,8" Width="200">
                                <TextBlock Text="البريد الإلكتروني" FontSize="11" Foreground="#FF888888" />
                                <TextBox Text="{Binding EditUser.Email, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            </StackPanel>
                            <StackPanel Margin="0,0,15,8" Width="150">
                                <TextBlock Text="الهاتف" FontSize="11" Foreground="#FF888888" />
                                <TextBox Text="{Binding EditUser.Phone, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            </StackPanel>
                            <StackPanel Margin="0,0,15,8" Width="150">
                                <TextBlock Text="القسم" FontSize="11" Foreground="#FF888888" />
                                <TextBox Text="{Binding EditUser.Section, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                            </StackPanel>
                            <StackPanel Margin="0,0,15,8" Width="150">
                                <TextBlock Text="الدور" FontSize="11" Foreground="#FF888888" />
                                <ComboBox SelectedValue="{Binding EditUser.Role}" SelectedValuePath="Tag" Width="140">
                                    <ComboBoxItem Content="مدير النظام" Tag="{x:Static data:UserRole.SystemAdministrator}" />
                                    <ComboBoxItem Content="مدير القسم" Tag="{x:Static data:UserRole.DepartmentManager}" />
                                    <ComboBoxItem Content="متخصص دعم" Tag="{x:Static data:UserRole.SupportSpecialist}" />
                                    <ComboBoxItem Content="قراءة فقط" Tag="{x:Static data:UserRole.ReadOnly}" />
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="إلغاء" Padding="16,8" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="حفظ" Command="{Binding SaveUserCommand}"
                        Style="{StaticResource ActionButtonStyle}" Padding="16,8" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
