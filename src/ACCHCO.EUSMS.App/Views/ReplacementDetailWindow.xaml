<Window x:Class="ACCHCO.EUSMS.App.Views.ReplacementDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="clr-namespace:ACCHCO.EUSMS.Data.Entities;assembly=ACCHCO.EUSMS.Data"
        FlowDirection="RightToLeft"
        Icon="/Assets/app.ico"
        Title="تسجيل استبدال جديد" Width="550" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleTextBlock" Text="تسجيل استبدال جديد" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15" />

        <StackPanel Grid.Row="1">
            <WrapPanel>
                <StackPanel Margin="0,0,15,10" Width="220">
                    <TextBlock Text="الجهاز القديم *" FontSize="11" Foreground="#FF888888" Margin="0,0,0,3" />
                    <ComboBox x:Name="OldEquipmentCombo" DisplayMemberPath="Name" Width="210" />
                </StackPanel>
                <StackPanel Margin="0,0,15,10" Width="220">
                    <TextBlock Text="الجهاز الجديد *" FontSize="11" Foreground="#FF888888" Margin="0,0,0,3" />
                    <ComboBox x:Name="NewEquipmentCombo" DisplayMemberPath="Name" Width="210" />
                </StackPanel>
            </WrapPanel>
            <WrapPanel>
                <StackPanel Margin="0,0,15,10" Width="150">
                    <TextBlock Text="التاريخ" FontSize="11" Foreground="#FF888888" Margin="0,0,0,3" />
                    <DatePicker x:Name="ReplacementDatePicker" Width="140" />
                </StackPanel>
                <StackPanel Margin="0,0,15,10" Width="350">
                    <TextBlock Text="سبب الاستبدال *" FontSize="11" Foreground="#FF888888" Margin="0,0,0,3" />
                    <TextBox x:Name="ReasonTextBox" Padding="6,4" />
                </StackPanel>
            </WrapPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="إلغاء" Padding="16,8" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="حفظ" Padding="16,8" Style="{StaticResource ActionButtonStyle}" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
