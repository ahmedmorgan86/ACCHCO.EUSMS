<UserControl x:Class="ACCHCO.EUSMS.App.Views.EquipmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ACCHCO.EUSMS.App.ViewModels"
             xmlns:helpers="clr-namespace:ACCHCO.EUSMS.App.Helpers"
             xmlns:data="clr-namespace:ACCHCO.EUSMS.Data.Entities;assembly=ACCHCO.EUSMS.Data"
             FlowDirection="RightToLeft"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBooleanConverter x:Key="InverseBool" />
        <helpers:NullToBoolConverter x:Key="NullToBool" />
        <helpers:NullToVisibilityConverter x:Key="NullToVis" />
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <helpers:EnumToArabicConverter x:Key="EnumToArabicConverter" />
        <helpers:EquipmentStatusToColorConverter x:Key="StatusColorConv" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="إدارة المعدات والأجهزة" Style="{StaticResource PageTitleStyle}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="➕ إضافة معدات" Command="{Binding AddNewCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" />
            <Button Content="✏️ تعديل المعدة" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding SelectedEquipment, Converter={StaticResource NullToBool}}" Margin="0,0,10,0" />
            <Button Content="🎫 إنشاء تذكرة" Command="{Binding CreateTicketForEquipmentCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding SelectedEquipment, Converter={StaticResource NullToBool}}" Margin="0,0,10,0" />
            <Button Content="🗑️ حذف المعدة" Command="{Binding DeleteEquipmentCommand}" Style="{StaticResource SecondaryButtonStyle}" Foreground="#FFDC2626" IsEnabled="{Binding SelectedEquipment, Converter={StaticResource NullToBool}}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="12">
            <WrapPanel>
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="النوع" FontSize="11" Foreground="#FF888888" />
                    <ComboBox Width="130" SelectedValue="{Binding FilterType}" SelectedValuePath="Tag" FontSize="12">
                        <ComboBoxItem Content="الكل" Tag="{x:Null}" />
                        <ComboBoxItem Content="ونش ساحة (RTG)" Tag="{x:Static data:EquipmentType.RTG}" />
                        <ComboBoxItem Content="معدة كالمر" Tag="{x:Static data:EquipmentType.Kalmar}" />
                        <ComboBoxItem Content="معدة هيستر" Tag="{x:Static data:EquipmentType.Hyster}" />
                        <ComboBoxItem Content="رافع حاويات" Tag="{x:Static data:EquipmentType.ReachStacker}" />
                        <ComboBoxItem Content="نقاط وصول" Tag="{x:Static data:EquipmentType.AccessPoint}" />
                        <ComboBoxItem Content="جهاز كمبيوتر" Tag="{x:Static data:EquipmentType.PC}" />
                        <ComboBoxItem Content="طابعات" Tag="{x:Static data:EquipmentType.Printer}" />
                        <ComboBoxItem Content="كاميرات البوابات" Tag="{x:Static data:EquipmentType.GatesOcrCamera}" />
                        <ComboBoxItem Content="جهاز لاسلكي" Tag="{x:Static data:EquipmentType.RDT}" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="الحالة" FontSize="11" Foreground="#FF888888" />
                    <ComboBox Width="130" SelectedValue="{Binding FilterStatus}" SelectedValuePath="Tag" FontSize="12">
                        <ComboBoxItem Content="الكل" Tag="{x:Null}" />
                        <ComboBoxItem Content="نشط" Tag="Active" />
                        <ComboBoxItem Content="غير نشط" Tag="Inactive" />
                        <ComboBoxItem Content="الصيانة" Tag="UnderMaintenance" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="الموقع" FontSize="11" Foreground="#FF888888" />
                    <TextBox Width="150" Text="{Binding FilterLocation, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="12" />
                </StackPanel>
                <Button Content="تصفية" Command="{Binding FilterCommand}" Style="{StaticResource ActionButtonStyle}"
                        VerticalAlignment="Bottom" Margin="0,0,5,0" Padding="12,8" />
                <Button Content="مسح" Command="{Binding LoadDataCommand}" VerticalAlignment="Bottom" Padding="12,8" />
            </WrapPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding EquipmentList}" Style="{StaticResource DataGridStyle}"
                  SelectedItem="{Binding SelectedEquipment}" ColumnWidth="SizeToCells">
            <DataGrid.ContextMenu>
                <ContextMenu FlowDirection="RightToLeft">
                    <MenuItem Header="🎫 إنشاء تذكرة لهذه المعدة" Command="{Binding CreateTicketForEquipmentCommand}" />
                    <MenuItem Header="✏️ تعديل المعدة" Command="{Binding EditCommand}" />
                    <Separator />
                    <MenuItem Header="🗑️ حذف المعدة" Command="{Binding DeleteEquipmentCommand}" Foreground="#FFDC2626" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="150" />
                <DataGridTextColumn Header="النوع" Binding="{Binding Type, Converter={StaticResource EnumToArabicConverter}}" Width="Auto" />
                <DataGridTextColumn Header="رقم الأصل" Binding="{Binding AssetTag}" Width="Auto" />
                <DataGridTextColumn Header="الرقم التسلسلي" Binding="{Binding SerialNumber}" Width="Auto" />
                <DataGridTextColumn Header="عنوان IP" Binding="{Binding IpAddress}" Width="Auto" />
                <DataGridTemplateColumn Header="الحالة" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status, Converter={StaticResource EnumToArabicConverter}}"
                                       Foreground="{Binding Status, Converter={StaticResource StatusColorConv}}"
                                       FontWeight="SemiBold" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"
                Padding="12" Margin="0,10,0,0">
            <StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="تعديل المعدات"
                               Visibility="{Binding IsNewEquipment, Converter={StaticResource InverseBoolToVis}}" />
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="إضافة معدات"
                               Visibility="{Binding IsNewEquipment, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,15,8" Width="200">
                        <TextBlock Text="الاسم *" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditEquipment.Name, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="150">
                        <TextBlock Text="النوع" FontSize="11" Foreground="#FF888888" />
                        <ComboBox SelectedValue="{Binding EditEquipment.Type}" SelectedValuePath="Tag" Width="140">
                            <ComboBoxItem Content="ونش ساحة (RTG)" Tag="{x:Static data:EquipmentType.RTG}" />
                            <ComboBoxItem Content="معدة كالمر" Tag="{x:Static data:EquipmentType.Kalmar}" />
                            <ComboBoxItem Content="معدة هيستر" Tag="{x:Static data:EquipmentType.Hyster}" />
                            <ComboBoxItem Content="رافع حاويات" Tag="{x:Static data:EquipmentType.ReachStacker}" />
                            <ComboBoxItem Content="نقطة وصول" Tag="{x:Static data:EquipmentType.AccessPoint}" />
                            <ComboBoxItem Content="جهاز كمبيوتر" Tag="{x:Static data:EquipmentType.PC}" />
                            <ComboBoxItem Content="طابعة" Tag="{x:Static data:EquipmentType.Printer}" />
                            <ComboBoxItem Content="كاميرات البوابات" Tag="{x:Static data:EquipmentType.GatesOcrCamera}" />
                            <ComboBoxItem Content="جهاز لاسلكي" Tag="{x:Static data:EquipmentType.RDT}" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="130">
                        <TextBlock Text="رقم الأصل" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditEquipment.AssetTag, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="150">
                        <TextBlock Text="اسم الجهاز" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditEquipment.ComputerName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="130">
                        <TextBlock Text="عنوان IP" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditEquipment.IpAddress, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="150">
                        <TextBlock Text="الموقع" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditEquipment.Location, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="130">
                        <TextBlock Text="القسم" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditEquipment.Section, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="150">
                        <TextBlock Text="مسند إلى" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditEquipment.AssignedTo, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="130">
                        <TextBlock Text="الحالة" FontSize="11" Foreground="#FF888888" />
                        <ComboBox SelectedValue="{Binding EditEquipment.Status}" SelectedValuePath="Tag" Width="120">
                            <ComboBoxItem Content="نشط" Tag="{x:Static data:EquipmentStatus.Active}" />
                            <ComboBoxItem Content="غير نشط" Tag="{x:Static data:EquipmentStatus.Inactive}" />
                            <ComboBoxItem Content="قيد الصيانة" Tag="{x:Static data:EquipmentStatus.UnderMaintenance}" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="200">
                        <TextBlock Text="ملاحظات" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditEquipment.Notes, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    </StackPanel>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <Button Content="إلغاء" Command="{Binding CancelEditCommand}" Padding="16,8" Margin="0,0,8,0" />
                    <Button Content="حفظ" Command="{Binding SaveEquipmentCommand}"
                            Style="{StaticResource ActionButtonStyle}" Padding="16,8" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
