<UserControl x:Class="ACCHCO.EUSMS.App.Views.PerformanceAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:helpers="clr-namespace:ACCHCO.EUSMS.App.Helpers"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <helpers:CountToVisibilityConverter x:Key="CountToVis" />
        <helpers:EmptyCountToVisibilityConverter x:Key="EmptyCountToVis" />
        <helpers:InverseBooleanConverter x:Key="InverseBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SmallExportButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>

            <!-- رأس الصفحة -->
            <TextBlock Text="تحليلات الأداء والمعدات" Style="{StaticResource PageTitleStyle}" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="🔄 تحديث البيانات" Command="{Binding LoadDataCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="16,10"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" />
            </StackPanel>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,14"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <!-- بطاقات مؤشرات الأداء -->
            <ItemsControl ItemsSource="{Binding Kpis}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="196" Margin="0,0,12,12" Padding="16,14" CornerRadius="16"
                                Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Opacity="0.05" ShadowDepth="3" Color="#FF0F172A" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="12" Background="{Binding ChipColor}">
                                    <TextBlock Text="{Binding Icon}" FontSize="19"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Value}" FontSize="21" FontWeight="ExtraBold"
                                               Foreground="#FF0F172A" />
                                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#FF64748B"
                                               Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- معدلات أعطال المعدات -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="📄 PDF" Command="{Binding ExportPdfCommand}" CommandParameter="معدلات_أعطال_المعدات"
                                        Style="{StaticResource SmallExportButtonStyle}" Margin="0,0,6,0" />
                                <Button Content="📊 Excel" Command="{Binding ExportExcelCommand}" CommandParameter="معدلات_أعطال_المعدات"
                                        Style="{StaticResource SmallExportButtonStyle}" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="معدلات أعطال المعدات"
                                       Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="لا توجد بيانات بعد" Foreground="#FF94A3B8" FontSize="12" Margin="0,16"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding EquipmentFaultRates.Count, Converter={StaticResource EmptyCountToVis}}" />

                        <lvc:CartesianChart FlowDirection="LeftToRight" Height="210" Margin="0,6,0,0"
                                            Series="{Binding FaultRateSeries}"
                                            XAxes="{Binding FaultXAxis}"
                                            YAxes="{Binding YAxis}"
                                            Visibility="{Binding EquipmentFaultRates.Count, Converter={StaticResource CountToVis}}" />
                    </StackPanel>
                </Border>

                <!-- نسبة إنجاز التذاكر -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="نسبة إنجاز التذاكر" Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,0,0,4" />
                        <Grid Width="240" Height="210" HorizontalAlignment="Center" Margin="0,6">
                            <lvc:PieChart FlowDirection="LeftToRight" Series="{Binding DonutSeries}" LegendPosition="Hidden" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ResolutionRate, StringFormat={}{0:0.0}%}" FontSize="28"
                                           FontWeight="ExtraBold" Foreground="#FF16A34A" HorizontalAlignment="Center" />
                                <TextBlock Text="نسبة الحل" FontSize="12" Foreground="#FF64748B"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#FF16A34A" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="مغلقة" FontSize="12" Foreground="#FF334155" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ClosedTicketCount}" FontSize="13" FontWeight="Bold"
                                           Foreground="#FF0F172A" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#FFF59E0B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="مفتوحة" FontSize="12" Foreground="#FF334155" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OpenTicketCount}" FontSize="13" FontWeight="Bold"
                                           Foreground="#FF0F172A" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- الأعطال الأكثر شيوعاً -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="📄 PDF" Command="{Binding ExportPdfCommand}" CommandParameter="الأعطال_الأكثر_شيوعا"
                                        Style="{StaticResource SmallExportButtonStyle}" Margin="0,0,6,0" />
                                <Button Content="📊 Excel" Command="{Binding ExportExcelCommand}" CommandParameter="الأعطال_الأكثر_شيوعا"
                                        Style="{StaticResource SmallExportButtonStyle}" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="الأعطال الأكثر شيوعاً"
                                       Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="لا توجد بيانات بعد" Foreground="#FF94A3B8" FontSize="12" Margin="0,16"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding CommonFaults.Count, Converter={StaticResource EmptyCountToVis}}" />

                        <lvc:CartesianChart FlowDirection="LeftToRight" Height="210" Margin="0,6,0,0"
                                            Series="{Binding CommonFaultSeries}"
                                            XAxes="{Binding CommonFaultXAxis}"
                                            YAxes="{Binding YAxis}"
                                            Visibility="{Binding CommonFaults.Count, Converter={StaticResource CountToVis}}" />
                    </StackPanel>
                </Border>

                <!-- أداء الأخصائيين -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="📄 PDF" Command="{Binding ExportPdfCommand}" CommandParameter="أداء_الأخصائيين"
                                        Style="{StaticResource SmallExportButtonStyle}" Margin="0,0,6,0" />
                                <Button Content="📊 Excel" Command="{Binding ExportExcelCommand}" CommandParameter="أداء_الأخصائيين"
                                        Style="{StaticResource SmallExportButtonStyle}" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="أداء الأخصائيين"
                                       Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="لا توجد بيانات بعد" Foreground="#FF94A3B8" FontSize="12" Margin="0,16"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding SpecialistLeaderboard.Count, Converter={StaticResource EmptyCountToVis}}" />

                        <lvc:CartesianChart FlowDirection="LeftToRight" Height="210" Margin="0,6,0,0"
                                            Series="{Binding SpecialistSeries}"
                                            XAxes="{Binding SpecialistXAxis}"
                                            YAxes="{Binding YAxis}"
                                            Visibility="{Binding SpecialistLeaderboard.Count, Converter={StaticResource CountToVis}}" />
                    </StackPanel>
                </Border>

                <!-- توزيع التذاكر حسب الوردية -->
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="📄 PDF" Command="{Binding ExportPdfCommand}" CommandParameter="توزيع_التذاكر_حسب_الوردية"
                                        Style="{StaticResource SmallExportButtonStyle}" Margin="0,0,6,0" />
                                <Button Content="📊 Excel" Command="{Binding ExportExcelCommand}" CommandParameter="توزيع_التذاكر_حسب_الوردية"
                                        Style="{StaticResource SmallExportButtonStyle}" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="توزيع التذاكر حسب الوردية"
                                       Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="لا توجد بيانات بعد" Foreground="#FF94A3B8" FontSize="12" Margin="0,16"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding ShiftSegments.Count, Converter={StaticResource EmptyCountToVis}}" />

                        <lvc:CartesianChart FlowDirection="LeftToRight" Height="180" Margin="0,6,0,0"
                                            Series="{Binding ShiftSeries}"
                                            XAxes="{Binding ShiftXAxis}"
                                            YAxes="{Binding YAxis}"
                                            Visibility="{Binding ShiftSegments.Count, Converter={StaticResource CountToVis}}" />

                        <ItemsControl ItemsSource="{Binding ShiftSegments}" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="6,0" Padding="12,14" CornerRadius="14" Background="#FFF8FAFC"
                                            BorderBrush="#FFE2E8F0" BorderThickness="1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="10" Height="10" Fill="{Binding Color}"
                                                         Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#FF334155"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Percent, StringFormat={}{0:0.0}%}" FontSize="26"
                                                       FontWeight="ExtraBold" Foreground="#FF0F172A"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Count, StringFormat={}تذكرة: {0}}" FontSize="11"
                                                       Foreground="#FF64748B" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
