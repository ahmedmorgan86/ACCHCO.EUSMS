<UserControl x:Class="ACCHCO.EUSMS.App.Views.ProblemManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:ACCHCO.EUSMS.App.Helpers"
             xmlns:enums="clr-namespace:ACCHCO.EUSMS.Data.Entities;assembly=ACCHCO.EUSMS.Data"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <helpers:NullToBoolConverter x:Key="NullToBool" />
        <helpers:NullToVisibilityConverter x:Key="NullToVis" />
        <helpers:InverseNullToVisibilityConverter x:Key="InverseNullToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="إدارة المشاكل" Style="{StaticResource PageTitleStyle}" DockPanel.Dock="Right" />
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="إلغاء" Command="{Binding CancelEditCommand}" Padding="12,8"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                <Button Content="إغلاق" Command="{Binding CloseCommand}" Padding="12,8"
                        IsEnabled="{Binding SelectedProblem, Converter={StaticResource NullToBool}}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                <Button Content="حل" Command="{Binding ResolveCommand}" Padding="12,8"
                        IsEnabled="{Binding SelectedProblem, Converter={StaticResource NullToBool}}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                <Button Content="حل بديل" Command="{Binding SetWorkaroundCommand}" Padding="12,8"
                        IsEnabled="{Binding SelectedProblem, Converter={StaticResource NullToBool}}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                <Button Content="تحديد السبب الجذري" Command="{Binding IdentifyRootCauseCommand}" Padding="12,8"
                        IsEnabled="{Binding SelectedProblem, Converter={StaticResource NullToBool}}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                <Button Content="حفظ" Command="{Binding SaveCommand}"
                        Style="{StaticResource ActionButtonStyle}" Padding="12,8"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                <Button Content="حذف" Command="{Binding DeleteCommand}"
                        Background="#FFF44336" Foreground="White" Padding="12,8"
                        IsEnabled="{Binding SelectedProblem, Converter={StaticResource NullToBool}}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                <Button Content="تعديل" Command="{Binding EditCommand}" Padding="12,8"
                        IsEnabled="{Binding SelectedProblem, Converter={StaticResource NullToBool}}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
                <Button Content="إضافة" Command="{Binding AddNewCommand}"
                        Style="{StaticResource ActionButtonStyle}" Padding="12,8"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,8,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="12">
            <WrapPanel>
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="الحالة" FontSize="11" Foreground="#FF888888" />
                    <ComboBox Width="130" SelectedValue="{Binding FilterStatus}" SelectedValuePath="Tag" FontSize="12">
                        <ComboBoxItem Content="الكل" Tag="{x:Null}" />
                        <ComboBoxItem Content="مسجّلة" Tag="{x:Static enums:ProblemStatus.Logged}" />
                        <ComboBoxItem Content="قيد البحث" Tag="{x:Static enums:ProblemStatus.Investigating}" />
                        <ComboBoxItem Content="تم تحديد السبب الجذري" Tag="{x:Static enums:ProblemStatus.RootCauseIdentified}" />
                        <ComboBoxItem Content="حل بديل معروف" Tag="{x:Static enums:ProblemStatus.WorkaroundKnown}" />
                        <ComboBoxItem Content="تم الحل" Tag="{x:Static enums:ProblemStatus.Resolved}" />
                        <ComboBoxItem Content="مغلقة" Tag="{x:Static enums:ProblemStatus.Closed}" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,15,5">
                    <TextBlock Text="بحث" FontSize="11" Foreground="#FF888888" />
                    <TextBox Width="200" Text="{Binding FilterSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" FontSize="12" />
                </StackPanel>
                <Button Content="تصفية" Command="{Binding FilterCommand}" Style="{StaticResource ActionButtonStyle}"
                        VerticalAlignment="Bottom" Margin="0,0,5,0" Padding="12,8" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="150" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0" ItemsSource="{Binding ProblemList}" Style="{StaticResource DataGridStyle}"
                      SelectedItem="{Binding SelectedProblem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم المشكلة" Binding="{Binding ProblemNumber}" Width="120" />
                    <DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="200" />
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="130" />
                    <DataGridTextColumn Header="الأولوية" Binding="{Binding Priority}" Width="90" />
                    <DataGridTextColumn Header="السبب الجذري" Binding="{Binding RootCause}" Width="180" />
                    <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8"
                    Visibility="{Binding SelectedProblem, Converter={StaticResource NullToVis}}" Margin="0,4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="الحوادث المرتبطة" Style="{StaticResource SectionHeaderStyle}" />
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="ربط" Command="{Binding LinkIncidentCommand}" Padding="10,5"
                                Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                        <ComboBox Width="180" SelectedItem="{Binding SelectedIncidentForLink}" FontSize="12"
                                  DisplayMemberPath="IncidentNumber" />
                        <Button Content="تحميل الحوادث" Command="{Binding LoadLinkedIncidentsCommand}" Padding="10,5" Margin="0,0,8,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <DataGrid Grid.Row="2" ItemsSource="{Binding LinkedIncidents}" Style="{StaticResource DataGridStyle}"
                      Visibility="{Binding SelectedProblem, Converter={StaticResource NullToVis}}" Margin="0,4,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الحادث" Binding="{Binding IncidentNumber}" Width="120" />
                    <DataGridTextColumn Header="الوصف" Binding="{Binding ProblemDescription}" Width="*" />
                    <DataGridTextColumn Header="الخطورة" Binding="{Binding Severity}" Width="90" />
                    <DataGridTextColumn Header="الحالة" Binding="{Binding WorkflowStatus}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"
                Padding="12" Margin="0,10,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                <StackPanel>
                    <TextBlock Text="بيانات المشكلة" Style="{StaticResource SectionHeaderStyle}" />

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="العنوان" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditProblem.Title, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="الوصف" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditProblem.Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60" Padding="6,4" />
                    </StackPanel>

                    <WrapPanel>
                        <StackPanel Margin="0,0,15,8" Width="160">
                            <TextBlock Text="الأولوية" FontSize="11" Foreground="#FF888888" />
                            <ComboBox SelectedValue="{Binding EditProblem.Priority}" SelectedValuePath="Tag" Width="150">
                                <ComboBoxItem Content="منخفضة" Tag="{x:Static enums:Priority.Low}" />
                                <ComboBoxItem Content="متوسطة" Tag="{x:Static enums:Priority.Medium}" />
                                <ComboBoxItem Content="عالية" Tag="{x:Static enums:Priority.High}" />
                                <ComboBoxItem Content="حرجة" Tag="{x:Static enums:Priority.Critical}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,15,8" Width="160">
                            <TextBlock Text="الحالة" FontSize="11" Foreground="#FF888888" />
                            <ComboBox SelectedValue="{Binding EditProblem.Status}" SelectedValuePath="Tag" Width="150">
                                <ComboBoxItem Content="مسجّلة" Tag="{x:Static enums:ProblemStatus.Logged}" />
                                <ComboBoxItem Content="قيد البحث" Tag="{x:Static enums:ProblemStatus.Investigating}" />
                                <ComboBoxItem Content="تم تحديد السبب الجذري" Tag="{x:Static enums:ProblemStatus.RootCauseIdentified}" />
                                <ComboBoxItem Content="حل بديل معروف" Tag="{x:Static enums:ProblemStatus.WorkaroundKnown}" />
                                <ComboBoxItem Content="تم الحل" Tag="{x:Static enums:ProblemStatus.Resolved}" />
                                <ComboBoxItem Content="مغلقة" Tag="{x:Static enums:ProblemStatus.Closed}" />
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="السبب الجذري" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditProblem.RootCause, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="50" Padding="6,4" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="الحل البديل" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditProblem.Workaround, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="50" Padding="6,4" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="الحل الدائم" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditProblem.PermanentSolution, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="50" Padding="6,4" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button Content="إلغاء" Command="{Binding CancelEditCommand}" Padding="16,8" Margin="0,0,8,0" />
                        <Button Content="حفظ" Command="{Binding SaveCommand}"
                                Style="{StaticResource ActionButtonStyle}" Padding="16,8" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
