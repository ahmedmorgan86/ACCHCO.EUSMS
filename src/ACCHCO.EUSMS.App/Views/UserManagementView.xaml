<UserControl x:Class="ACCHCO.EUSMS.App.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ACCHCO.EUSMS.App.ViewModels"
             xmlns:helpers="clr-namespace:ACCHCO.EUSMS.App.Helpers"
             xmlns:data="clr-namespace:ACCHCO.EUSMS.Data.Entities;assembly=ACCHCO.EUSMS.Data"
             FlowDirection="RightToLeft"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:NullToBoolConverter x:Key="NullToBool" />
        <helpers:BoolToStatusColorConverter x:Key="StatusColorConv" />
        <helpers:BoolToStatusTextConverter x:Key="StatusTextConv" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="إدارة المستخدمين والأدوار" Style="{StaticResource PageTitleStyle}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="➕ إضافة مستخدم" Command="{Binding AddNewCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" />
            <Button Content="✏️ تعديل المستخدم" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToBool}}" Margin="0,0,10,0" />
            <Button Content="🚫 تعطيل المستخدم" Command="{Binding DeactivateUserCommand}" Style="{StaticResource SecondaryButtonStyle}" Foreground="#FFDC2626" IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToBool}}" />
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Users}" Style="{StaticResource DataGridStyle}"
                  SelectedItem="{Binding SelectedUser}" MinColumnWidth="150">
            <DataGrid.Columns>
                <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="150" />
                <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="230" />
                <DataGridTextColumn Header="البريد الإلكتروني" Binding="{Binding Email}" Width="200" />
                <DataGridTextColumn Header="القسم" Binding="{Binding Section}" Width="160" />
                <DataGridTextColumn Header="الدور" Binding="{Binding Role}" Width="160" />
                <DataGridTemplateColumn Header="نشط" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding IsActive, Converter={StaticResource StatusTextConv}, ConverterParameter=نشط|معطل}"
                                       Foreground="{Binding IsActive, Converter={StaticResource StatusColorConv}}"
                                       FontWeight="SemiBold" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="آخر دخول" Binding="{Binding LastLoginDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"
                Padding="12" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="محرر المستخدم" Style="{StaticResource SectionHeaderStyle}" />
                <WrapPanel>
                    <StackPanel Margin="0,0,15,8" Width="180">
                        <TextBlock Text="اسم المستخدم *" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditUser.Username, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="200">
                        <TextBlock Text="الاسم الكامل *" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditUser.FullName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="200">
                        <TextBlock Text="البريد الإلكتروني" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditUser.Email, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="150">
                        <TextBlock Text="الهاتف" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditUser.Phone, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="150">
                        <TextBlock Text="القسم" FontSize="11" Foreground="#FF888888" />
                        <TextBox Text="{Binding EditUser.Section, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                    </StackPanel>
                    <StackPanel Margin="0,0,15,8" Width="150">
                        <TextBlock Text="الدور" FontSize="11" Foreground="#FF888888" />
                        <ComboBox SelectedValue="{Binding EditUser.Role}" SelectedValuePath="Tag" Width="140">
                            <ComboBoxItem Content="مدير النظام" Tag="{x:Static data:UserRole.SystemAdministrator}" />
                            <ComboBoxItem Content="مدير القسم" Tag="{x:Static data:UserRole.DepartmentManager}" />
                            <ComboBoxItem Content="متخصص دعم" Tag="{x:Static data:UserRole.SupportSpecialist}" />
                            <ComboBoxItem Content="قراءة فقط" Tag="{x:Static data:UserRole.ReadOnly}" />
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="إلغاء" Command="{Binding CancelEditCommand}" Padding="16,8" Margin="0,0,8,0" />
                    <Button Content="حفظ" Command="{Binding SaveUserCommand}"
                            Style="{StaticResource ActionButtonStyle}" Padding="16,8" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
